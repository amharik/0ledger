{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "wxt.config.ts",
    "vitest.config.ts",
    ".wxt/wxt.d.ts",
    "server.ts",
    "server.config.ts",
    "scripts"
  ]
}
