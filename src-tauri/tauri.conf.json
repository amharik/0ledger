{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "0ledger",
  "version": "0.1.0",
  "identifier": "com.zerowork.zeroledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "0ledger — Local-First Accounting for Indian Business",
        "width": 1360,
        "height": 880,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ]
  }
}