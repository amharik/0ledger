{
  "name": "0ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first double-entry ledger and tax reconciliation for Indian businesses — native desktop app powered by Tauri.",
  "license": "MIT",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build --config vite.config.desktop.ts",
    "lint": "tsc --noEmit",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "tauri:dev": "tsx scripts/tauri-dev.ts",
    "tauri:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "tauri:build:debug": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --debug",
    "dev:mv3:deprecated": "wxt",
    "build:mv3:deprecated": "wxt build",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "STRESS=1 vitest run tests/release-stress.test.ts",
    "server:token": "tsx scripts/server-token.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@types/express": "^5.0.6",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "imapflow": "^2.12.2",
    "lucide-react": "^1.77.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.4.3"
}
